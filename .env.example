# See docs/ENVIRONMENT.md and deploy/env/*.env.example

APP_ENV=development
NODE_ENV=development

DATABASE_URL=postgresql://kesbyar:kesbyar@localhost:5432/kesbyar?schema=public

NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# Cron (Bearer or x-cron-secret for /api/cron/automation)
CRON_SECRET=change-me-cron-secret

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=internal-dev-token-change-in-production
AI_SERVICE_TIMEOUT_MS=45000
AI_SERVICE_RETRIES=1

LOG_LEVEL=debug
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

ALLOW_SEED=true

# Optional: billing / notifications (prefer per-org credentials in Settings UI)
# BILLING_PROVIDER=zarinpal
# NOTIFICATION_PROVIDER=kavenegar
# SMS_KAVENEGAR_API_KEY=
# SMS_KAVENEGAR_SENDER=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# TELEGRAM_BOT_TOKEN=

# Web Push (optional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Monitoring (optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Destructive DB scripts (production)
# CONFIRM_MIGRATE_DEPLOY=true
